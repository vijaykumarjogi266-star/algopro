# Algo Lab Environment Configuration
# Stage 1 Foundation

# Environment mode: development, testing, production
ENVIRONMENT=development
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Algo Lab Research OS"
PROJECT_VERSION="0.1.0"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL)
POSTGRES_USER=algolab
POSTGRES_PASSWORD=algolab_secret
POSTGRES_DB=algolab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://algolab:algolab_secret@localhost:5432/algolab
DATABASE_URL_SYNC=postgresql://algolab:algolab_secret@localhost:5432/algolab

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Non-Negotiable Hard Safeguards (System Level)
ALLOW_LIVE_TRADING=false
ALLOW_REAL_BROKER_EXECUTION=false
REQUIRE_DATA_VALIDATION=true
ENFORCE_STRICT_LOOKAHEAD_PROTECTION=true
