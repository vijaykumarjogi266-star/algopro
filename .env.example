# Algo Lab Environment Configuration
# Stage 1 Foundation

# Environment mode: development, testing, production
ENVIRONMENT=development
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Algo Lab Research OS"
PROJECT_VERSION="0.1.0"

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security Keys
# Generate API key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ALGO_LAB_API_KEY=CHANGE_ME_STRONG_RANDOM_API_KEY

# Circuit Breaker Rearm Secret
CIRCUIT_BREAKER_REARM_SECRET=CHANGE_ME_REARM_SECRET_KEY

# Broker Credential Encryption Key (Fernet URL-safe 32-byte base64)
# Generate via: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_FERNET_BASE64_KEY

# Database (PostgreSQL)
# Generate strong password: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=algolab
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
POSTGRES_DB=algolab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://algolab:${POSTGRES_PASSWORD}@localhost:5432/algolab
DATABASE_URL_SYNC=postgresql://algolab:${POSTGRES_PASSWORD}@localhost:5432/algolab

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Non-Negotiable Hard Safeguards (System Level)
ALLOW_LIVE_TRADING=false
ALLOW_REAL_BROKER_EXECUTION=false
REQUIRE_DATA_VALIDATION=true
ENFORCE_STRICT_LOOKAHEAD_PROTECTION=true
