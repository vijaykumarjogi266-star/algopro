[Unit]
Description=Algo Lab Quantitative Paper & Forward Trading Daemon
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/algopro
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/algopro/.venv/bin/python run_live_paper_daemon.py
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

# Resource & Sandboxing Guardrails
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=4G
TasksMax=1024

# Security Hardening
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/algopro/data
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
