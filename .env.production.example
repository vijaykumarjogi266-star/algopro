# Production Environment Template (Algo Lab OS)
# NEVER commit populated values to version control.
# Generate strong random values using:
#   API Key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   Rearm:   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   Fernet:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   DB Pass: python3 -c "import secrets; print(secrets.token_urlsafe(32))"

ENVIRONMENT=production
DEBUG=false

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="Algo Lab Research OS"
PROJECT_VERSION="0.1.0"

# CORS (Restrict to internal frontend domain)
CORS_ORIGINS=["https://algolab.internal"]

# Security Credentials (MANDATORY IN PRODUCTION - FAIL CLOSED)
ALGO_LAB_API_KEY=REQUIRED_IN_PRODUCTION
CIRCUIT_BREAKER_REARM_SECRET=REQUIRED_IN_PRODUCTION
BROKER_CREDENTIAL_ENCRYPTION_KEY=REQUIRED_IN_PRODUCTION

# Database (PostgreSQL - Internal Network Only)
POSTGRES_USER=algolab
POSTGRES_PASSWORD=REQUIRED_IN_PRODUCTION
POSTGRES_DB=algolab
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://algolab:${POSTGRES_PASSWORD}@postgres:5432/algolab
DATABASE_URL_SYNC=postgresql://algolab:${POSTGRES_PASSWORD}@postgres:5432/algolab

# Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Safety Safeguards (IMMUTABLE IN PRODUCTION)
ALLOW_LIVE_TRADING=false
ALLOW_REAL_BROKER_EXECUTION=false
REQUIRE_DATA_VALIDATION=true
ENFORCE_STRICT_LOOKAHEAD_PROTECTION=true
